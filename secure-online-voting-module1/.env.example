# Local/Codespaces development only; replace with a unique secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-using-real-data
DJANGO_DEBUG=True
# Optional: use a hosted PostgreSQL database instead of temporary SQLite.
# Never commit a real DATABASE_URL to GitHub.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
